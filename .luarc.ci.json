{
  "runtime": {
    "version": "LuaJIT",
    "pathStrict": false,
    "path": ["?.lua", "?/init.lua", "lua/?.lua", "lua/?/init.lua"]
  },
  "diagnostics": {
    "globals": ["vim"]
  },
  "workspace": {
    "checkThirdParty": false,
    "ignoreDir": ["tests"],
    "library": ["/opt/nvim/share/nvim/runtime/lua", "/usr/share/nvim/runtime/lua"]
  }
}